<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yoink.Views.SettingsWindow"
        Title="Settings"
        Icon="/Assets/tray-icon.png"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="false">

    <StackPanel Margin="24" Spacing="18">

        <TextBlock Text="Settings" Classes="AppTitle" FontSize="20" />

        <StackPanel Spacing="4">
            <TextBlock Text="Appearance" Classes="SectionTitle" />
            <DockPanel>
                <TextBlock Text="Theme" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox Name="CboTheme" Width="120" HorizontalAlignment="Right"
                          SelectionChanged="CboTheme_SelectionChanged">
                    <ComboBoxItem>System</ComboBoxItem>
                    <ComboBoxItem>Light</ComboBoxItem>
                    <ComboBoxItem>Dark</ComboBoxItem>
                </ComboBox>
            </DockPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Auto-catch &amp; background" Classes="SectionTitle" />
            <CheckBox Name="ChkClipboardWatch" Content="Watch clipboard for YouTube links"
                      IsCheckedChanged="ChkClipboardWatch_IsCheckedChanged" />
            <TextBlock Text="When on, copying a YouTube link prompts to add it to the queue — nothing downloads without confirming first."
                       Classes="Caption" TextWrapping="Wrap" Margin="24,0,0,8" />
            <CheckBox Name="ChkMinimizeToTray" Content="Keep running in tray when closed"
                      IsCheckedChanged="ChkMinimizeToTray_IsCheckedChanged" />
            <TextBlock Text="Leave off if your system tray doesn't show app icons (plain GNOME without an extension, for instance) — otherwise closing the window would leave it with no way back."
                       Classes="Caption" TextWrapping="Wrap" Margin="24,0,0,0" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Downloads" Classes="SectionTitle" />
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Concurrent downloads" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <NumericUpDown Name="NudMaxConcurrent" Width="120" HorizontalAlignment="Right"
                                Minimum="1" Maximum="10" Increment="1" FormatString="0"
                                ValueChanged="NudMaxConcurrent_ValueChanged" />
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Per-download limit (KB/s)" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <NumericUpDown Name="NudPerDownloadLimit" Width="120" HorizontalAlignment="Right"
                                Minimum="0" Maximum="1000000" Increment="100" FormatString="0"
                                PlaceholderText="Unlimited" ValueChanged="NudPerDownloadLimit_ValueChanged" />
            </DockPanel>
            <DockPanel>
                <TextBlock Text="Global limit (KB/s)" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <NumericUpDown Name="NudGlobalLimit" Width="120" HorizontalAlignment="Right"
                                Minimum="0" Maximum="1000000" Increment="100" FormatString="0"
                                PlaceholderText="Unlimited" ValueChanged="NudGlobalLimit_ValueChanged" />
            </DockPanel>
            <TextBlock Classes="Caption" TextWrapping="Wrap"
                       Text="Leave a limit at 0 (or blank) for unlimited. The global limit is split evenly across concurrent downloads when it's set; the smaller of the two applies to each one."
                       Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Scheduling" Classes="SectionTitle" />
            <CheckBox Name="ChkSchedulingEnabled" Content="Only download during these hours"
                      IsCheckedChanged="ChkSchedulingEnabled_IsCheckedChanged" />
            <DockPanel Margin="24,4,0,0">
                <TextBlock Text="From" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TimePicker Name="TpScheduleStart" MinuteIncrement="15" SelectedTimeChanged="TpScheduleStart_SelectedTimeChanged" />
            </DockPanel>
            <DockPanel Margin="24,4,0,0">
                <TextBlock Text="To" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,20,0" />
                <TimePicker Name="TpScheduleEnd" MinuteIncrement="15" SelectedTimeChanged="TpScheduleEnd_SelectedTimeChanged" />
            </DockPanel>
            <TextBlock Classes="Caption" TextWrapping="Wrap"
                       Text="New downloads only start in this window (e.g. 10 PM to 6 AM for overnight) — a download already running when it ends is left to finish rather than interrupted."
                       Margin="24,4,0,0" />
        </StackPanel>

        <Button Content="Close" Classes="Primary" HorizontalAlignment="Right" Click="BtnClose_Click" />

    </StackPanel>

</Window>
