<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Yoink.Models"
        xmlns:converters="using:Yoink.Converters"
        xmlns:views="using:Yoink.Views"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Yoink.Views.MainWindow"
        Title="Yoink"
        Width="760" Height="640"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None">

    <!-- WindowDecorations="None": no OS-drawn frame at all, replaced by BtnMinimize/BtnMaximizeRestore/
         BtnClose below plus MainWindow.axaml.cs's resize-edge wiring. Not the cooperative
         ExtendClientAreaToDecorationsHint approach this used at first — that only actually merges
         with a shared title bar row on platforms whose window manager paints caption buttons inside
         the extended region (confirmed working that way on Windows' DWM); GNOME/Mutter (this app's
         primary dev platform) just keeps painting its own full separate title bar frame regardless of
         the hint, so on Linux specifically nothing short of owning every pixel actually merges the two
         bars. See the merged-titlebar-navbar project memory for the full story, including why
         FluentAvaloniaUI's own AppWindow/TitleBar wasn't used either. -->
    <Panel>

        <!-- Resize handles — WindowDecorations="None" also removes the OS's own edge-drag resize, so
             these thin (4px edges, 8px corners) transparent strips stand in for it via
             Window.BeginResizeDrag. Declared before (so beneath, z-order-wise) MainGrid below, which
             covers all of them except this narrow outer ring — MainGrid's own Margin="4" is what
             leaves that ring clear to receive pointer events at all. -->
        <Border Name="ResizeN" Height="4" VerticalAlignment="Top" Cursor="SizeNorthSouth"
                Background="Transparent" Tag="North" PointerPressed="ResizeEdge_PointerPressed" />
        <Border Name="ResizeS" Height="4" VerticalAlignment="Bottom" Cursor="SizeNorthSouth"
                Background="Transparent" Tag="South" PointerPressed="ResizeEdge_PointerPressed" />
        <Border Name="ResizeW" Width="4" HorizontalAlignment="Left" Cursor="SizeWestEast"
                Background="Transparent" Tag="West" PointerPressed="ResizeEdge_PointerPressed" />
        <Border Name="ResizeE" Width="4" HorizontalAlignment="Right" Cursor="SizeWestEast"
                Background="Transparent" Tag="East" PointerPressed="ResizeEdge_PointerPressed" />
        <Border Name="ResizeNW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="TopLeftCorner" Background="Transparent" Tag="NorthWest" PointerPressed="ResizeEdge_PointerPressed" />
        <Border Name="ResizeNE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="TopRightCorner" Background="Transparent" Tag="NorthEast" PointerPressed="ResizeEdge_PointerPressed" />
        <Border Name="ResizeSW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Cursor="BottomLeftCorner" Background="Transparent" Tag="SouthWest" PointerPressed="ResizeEdge_PointerPressed" />
        <Border Name="ResizeSE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="BottomRightCorner" Background="Transparent" Tag="SouthEast" PointerPressed="ResizeEdge_PointerPressed" />

        <!-- A bare 1px outline stands in for whatever subtle edge the OS frame used to draw — no
             Background, so (unlike the resize strips above) it never receives pointer events itself. -->
        <Border Margin="4" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" IsHitTestVisible="False" />

        <!-- Rows, not one shared area: NavView (Row 0) holds only the top strip now — its Content is
             deliberately left unset, so it auto-sizes to just the pane row's own natural height
             rather than stretching to fill the rest of the window — with DownloadsBody/SettingsBody
             moved to Row 1 as full-width siblings instead of living inside NavView.Content the way
             they used to. That's what NavView.Margin's caption-button-space reservation (still set in
             MainWindow_Opened, unchanged) now insets only: the top strip alone, not the body — see
             this file's Panel-level comment for why reserving it at all is necessary, and the
             merged-titlebar-navbar project memory for why the reservation used to bleed into the body
             (margining the combined NavView, back when Content was still nested inside it, shrank
             both together) before this split fixed it. -->
        <Grid Name="MainGrid" Margin="4" RowDefinitions="Auto,*">

    <!-- The app shell: a top nav bar (icon+wordmark, plus FluentAvalonia's built-in Settings entry —
         no menu item for Downloads, since that's the home/dashboard, not something you navigate to)
         over a body that swaps between DownloadsBody and SettingsBody — see
         NavView_SelectionChanged/NavView_BackRequested in the code-behind. Settings used to be a
         separate modal Window; it's a page in this same shell now, with the nav bar's own back
         button as the way out (shown only while on that page — Downloads has nowhere to go "back"
         from), so it actually feels like part of the app.

         This same top row also doubles as the window's own title bar now that there's no OS-drawn one
         at all — see MainWindow_Opened in the code-behind for how NavView's own Margin reserves space
         for CaptionButtons below on whichever side matches the platform (right on Windows/Linux, left
         on macOS), so the icon+wordmark/Settings tab never render underneath them. -->
    <ui:FANavigationView x:Name="NavView" Grid.Row="0"
                         PaneDisplayMode="Top"
                         IsSettingsVisible="True"
                         IsBackButtonVisible="False"
                         IsBackEnabled="False"
                         BackRequested="NavView_BackRequested"
                         SelectionChanged="NavView_SelectionChanged">

        <!-- NOT PaneHeader — verified (via a headless-rendered frame, not guesswork) that
             FluentAvaloniaUI 3.1.0's Top-mode template simply never presents PaneHeader/PaneTitle at
             all; PaneCustomContent is the slot that actually renders on the left in this mode. -->
        <ui:FANavigationView.PaneCustomContent>
            <!-- chrome:WindowDecorationProperties.ElementRole="TitleBar" and the manual
                 PointerPressed handler below are belt-and-braces: the attached property is
                 documented to grant native drag-to-move/double-click-to-maximize on its own, but
                 since that couldn't be confirmed on this dev platform (headless rendering shows no
                 real window manager at all), BeginMoveDrag is wired directly too so dragging the
                 window definitely works even if the attached property turns out to be a no-op here. -->
            <StackPanel Name="TitleBarDragHandle" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="12,0,20,0"
                        Background="Transparent"
                        chrome:WindowDecorationProperties.ElementRole="TitleBar"
                        PointerPressed="TitleBarDragHandle_PointerPressed">
                <Path Classes="YoinkMark" Width="22" Height="22" StrokeThickness="2"
                      Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Yoink" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </ui:FANavigationView.PaneCustomContent>
    </ui:FANavigationView>

        <!-- The actual page body — a sibling of NavView (Row 1) rather than living inside its
             Content the way it used to: NavView.Margin's caption-button-space reservation shrank
             this along with the pane row when it was nested in there, which is exactly the blank
             strip down the right edge that got reported after the previous commit. Full width here,
             no reservation needed — CaptionButtons only occupies Row 0's height. -->
        <Grid Grid.Row="1" Margin="32,28">

            <!-- Downloads (default). Used to be wrapped in a Border.Card (rounded, bordered box)
                 sitting inside the window's own rounded frame — a "box inside a box" look that read
                 as visual clutter rather than structure. Dropped in favor of the page sitting
                 directly on the window's own background, with a hairline rule under the header
                 standing in for the separation the card border used to provide. -->
            <DockPanel Name="DownloadsBody">
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1"
                        Padding="0,0,0,16" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Downloads" Classes="AppTitle" />
                            <TextBlock Text="Grab a video, keep watching." Classes="Subtitle" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ Add download" Classes="Primary"
                                VerticalAlignment="Center" Click="BtnAddDownload_Click" />
                    </Grid>
                </Border>

                <Grid>
                    <!-- Empty state: centered in the remaining space rather than a single caption
                         line pinned to the top, now that there's room to give it presence. -->
                    <StackPanel Name="TxtEmptyQueue" IsVisible="False" MaxWidth="320" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Classes="YoinkMark" Width="44" Height="44" StrokeThickness="2.5" Opacity="0.45"
                              Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Nothing queued yet" Classes="SectionTitle" Margin="0"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Click &quot;Add download&quot; above to grab your first video."
                                   Classes="Caption" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer>
                        <ItemsControl Name="LstQueue">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DownloadQueueItem">
                                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Classes="Caption" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Status, Converter={x:Static converters:DownloadQueueStatusToBrushConverter.Instance}}" />
                                                    <Button Content="Pause" FontSize="12" IsVisible="{Binding CanPause}"
                                                            Click="BtnPause_Click" />
                                                    <Button Content="Resume" FontSize="12" IsVisible="{Binding CanResume}"
                                                            Click="BtnResume_Click" />
                                                    <Button Content="Cancel" FontSize="12" IsVisible="{Binding CanCancel}"
                                                            Click="BtnCancel_Click" />
                                                    <Button Content="Retry" FontSize="12" IsVisible="{Binding CanRetry}"
                                                            Click="BtnRetry_Click" />
                                                    <Button Content="Show in folder" FontSize="12" IsVisible="{Binding CanShowInFolder}"
                                                            Click="BtnShowInFolder_Click" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         IsVisible="{Binding ShowProgress}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- Settings — hidden by default, shown via the nav bar's built-in Settings entry -->
            <views:SettingsView Name="SettingsBody" IsVisible="False" />

        </Grid>

    <!-- The window controls this app now draws itself (see the Window-level WindowDecorations="None"
         comment above). Order/side is swapped for macOS in MainWindow_Opened — Close/Minimize/Maximize
         on the left there, matching every native macOS app, versus Minimize/Maximize/Close on the
         right everywhere else. Glyphs are hand-specified geometry (Path.CaptionGlyph, styled in
         App.axaml), the same technique Path.YoinkMark already uses, rather than FluentAvaloniaUI's
         icon set — FASymbolIcon's Symbol enum (FASymbol) turned out to be its large modern Fluent
         System Icons set with no minimize/maximize/close-shaped members at all, not the small
         Chrome*-named legacy WinUI2 Symbol set the strings in the DLL briefly suggested. -->
    <StackPanel Name="CaptionButtons" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
        <Button Name="BtnMinimize" Classes="CaptionButton" Click="BtnMinimize_Click" ToolTip.Tip="Minimize">
            <Path Classes="CaptionGlyph" Data="M 0,5 H 10" />
        </Button>
        <Button Name="BtnMaximizeRestore" Classes="CaptionButton" Click="BtnMaximizeRestore_Click" ToolTip.Tip="Maximize">
            <Path Name="IcoMaximizeRestore" Classes="CaptionGlyph" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
        </Button>
        <Button Name="BtnClose" Classes="CaptionButton CloseButton" Click="BtnClose_Click" ToolTip.Tip="Close">
            <Path Classes="CaptionGlyph" Data="M 0,0 L 10,10 M 0,10 L 10,0" />
        </Button>
    </StackPanel>

        </Grid>
    </Panel>
</Window>
