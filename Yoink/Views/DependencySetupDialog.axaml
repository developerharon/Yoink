<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Yoink.Views"
        x:Class="Yoink.Views.DependencySetupDialog"
        Title="Setting up Yoink"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None">

    <!-- Same custom chrome as AddDownloadDialog/MessageBoxWindow/UpdatePromptDialog — see
         DialogTitleBar's own comment. Shown once, the first time yt-dlp and/or ffmpeg aren't found
         anywhere on the machine (see MainWindow's EnsureDependenciesAsync): downloads whichever of
         the two is missing into Yoink's own managed folder so this app works out of the box on a
         packaged install, without the user separately installing either one themselves. -->
    <Panel>
        <Border Margin="4" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" IsHitTestVisible="False" />

        <Grid Margin="4" RowDefinitions="Auto,*">
            <views:DialogTitleBar Grid.Row="0" Title="Setting up Yoink" />

            <StackPanel Grid.Row="1" Margin="20,0,20,20" Spacing="14">
                <TextBlock Classes="Caption" TextWrapping="Wrap"
                           Text="Yoink needs yt-dlp and ffmpeg to download videos. Grabbing what's missing now — this only happens once." />

                <TextBlock Name="TxtStatus" TextWrapping="Wrap" Text="Checking…" />

                <ProgressBar Name="ProgressBar" IsIndeterminate="True" />

                <StackPanel Name="ErrorPanel" Spacing="14" IsVisible="False">
                    <TextBlock Name="TxtError" Classes="Caption" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Name="BtnClose" Content="Close" Click="BtnClose_Click" />
                        <Button Name="BtnRetry" Content="Retry" Classes="Primary" Click="BtnRetry_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Panel>

</Window>
