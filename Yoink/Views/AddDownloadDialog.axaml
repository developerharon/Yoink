<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Yoink.Views"
        x:Class="Yoink.Views.AddDownloadDialog"
        Title="Add download"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None">

    <!-- WindowDecorations="None": the same fully custom chrome MainWindow uses (see its own comment
         for why ExtendClientAreaToDecorationsHint doesn't merge on GNOME/Mutter), scaled down for a
         fixed-size modal — no resize edges (CanResize is already False) or minimize/maximize
         (nothing to minimize/maximize to), just DialogTitleBar's drag-to-move row and close button.
         This is what stops the "add download" form from reading like a bare default OS dialog next
         to MainWindow/SettingsView's designed look. -->
    <Panel>
        <Border Margin="4" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" IsHitTestVisible="False" />

        <Grid Margin="4" RowDefinitions="Auto,*">
            <views:DialogTitleBar Grid.Row="0" Name="TitleBar" Title="Add download" />

            <StackPanel Grid.Row="1" Margin="20,0,20,20" Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="YouTube URL" Classes="Caption" />
                    <TextBox Name="TxtUrl" PlaceholderText="https://www.youtube.com/watch?v=..." />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Resolution" Classes="Caption" />
                    <ComboBox Name="CboResolution" Width="110" SelectedIndex="0">
                        <ComboBoxItem>360</ComboBoxItem>
                        <ComboBoxItem>480</ComboBoxItem>
                        <ComboBoxItem>720</ComboBoxItem>
                        <ComboBoxItem>1080</ComboBoxItem>
                        <ComboBoxItem>1440</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" />
                    <Button Name="BtnAdd" Content="Add to queue" Classes="Primary" Click="BtnAdd_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Panel>

</Window>
