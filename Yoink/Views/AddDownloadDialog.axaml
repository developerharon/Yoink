<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Yoink.Views"
        x:Class="Yoink.Views.AddDownloadDialog"
        Title="Add download"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None">

    <!-- WindowDecorations="None": the same fully custom chrome MainWindow uses (see its own comment
         for why ExtendClientAreaToDecorationsHint doesn't merge on GNOME/Mutter), scaled down for a
         fixed-size modal — no resize edges (CanResize is already False) or minimize/maximize
         (nothing to minimize/maximize to), just DialogTitleBar's drag-to-move row and close button.

         Three stages, one panel each, toggled via IsVisible (same pattern MainWindow uses for
         DownloadsBody/SettingsBody) rather than separate windows/pages — see AddDownloadDialog.axaml.cs:
         PanelUrlEntry (paste a URL) -> PanelLoading (resolving it via yt-dlp or a plain HTTP probe,
         depending on the URL — visible feedback for what used to be a silent multi-second pause) ->
         PanelOptions -> queued. PanelOptions itself branches: PanelVideoOptions (resolution/container,
         built from what yt-dlp actually reported for that video) is shown for a YouTube URL and
         hidden for a generic file or torrent, where TxtFileMeta (size/type from the HTTP probe, or a
         torrent's own resolved size/file-count, or — for a magnet link, whose real size isn't known
         until the download actually starts — a short explanatory line) shows instead. A torrent
         source is either pasted into TxtUrl (a magnet link, or a direct URL to a .torrent file) or
         picked via BtnBrowseTorrentFile (a local .torrent file — see AddDownloadDialog.axaml.cs for
         how the two inputs don't fight each other). -->
    <Panel>
        <Border Margin="4" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" IsHitTestVisible="False" />

        <Grid Margin="4" RowDefinitions="Auto,*">
            <views:DialogTitleBar Grid.Row="0" Name="TitleBar" Title="Add download" />

            <StackPanel Grid.Row="1" Margin="20,0,20,20" Spacing="14">
                <StackPanel Name="PanelUrlEntry" Spacing="4">
                    <TextBlock Text="URL" Classes="Caption" />
                    <TextBox Name="TxtUrl" TextChanged="TxtUrl_TextChanged"
                             PlaceholderText="A YouTube link, a magnet link, or a direct file link (PDF, .torrent, ...)" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="or" Classes="Caption" VerticalAlignment="Center" />
                        <Button Name="BtnBrowseTorrentFile" Content="Browse for a .torrent file…" FontSize="12"
                                Click="BtnBrowseTorrentFile_Click" />
                    </StackPanel>
                    <TextBlock Name="TxtSelectedTorrentFile" Classes="Caption" IsVisible="False" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Name="PanelLoading" Spacing="10" IsVisible="False">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock Text="Resolving…" Classes="Caption" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Name="PanelOptions" Spacing="14" IsVisible="False">
                    <TextBlock Name="TxtResolvedTitle" FontWeight="Medium" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                    <TextBlock Name="TxtFileMeta" Classes="Caption" IsVisible="False" />

                    <StackPanel Name="PanelVideoOptions" Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Resolution" Classes="Caption" />
                            <ComboBox Name="CboResolution" Width="140" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Format" Classes="Caption" />
                            <ComboBox Name="CboContainer" Width="140" HorizontalAlignment="Left" SelectedIndex="0">
                                <ComboBoxItem>MP4</ComboBoxItem>
                                <ComboBoxItem>MKV</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Shown for every kind (Video/File/Torrent), not just PanelVideoOptions'
                         video-only pickers above — every download lands somewhere. Read-only
                         TextBox + Browse/Reset, same idiom as Views.SettingsView's own download
                         folder row, seeded from whatever Settings currently resolves to (not a
                         blank field) so the common case ("just use my configured default") needs
                         no interaction at all. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Save to" Classes="Caption" />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" Name="TxtDestinationFolder" IsReadOnly="True" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Name="BtnBrowseDestinationFolder" Content="Browse" FontSize="12"
                                    Click="BtnBrowseDestinationFolder_Click" Margin="0,0,6,0" />
                            <Button Grid.Column="2" Name="BtnResetDestinationFolder" Content="Reset" FontSize="12"
                                    Click="BtnResetDestinationFolder_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" />
                    <Button Name="BtnPrimary" Content="Continue" Classes="Primary" Click="BtnPrimary_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Panel>

</Window>
