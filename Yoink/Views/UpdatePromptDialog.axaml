<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Yoink.Views"
        x:Class="Yoink.Views.UpdatePromptDialog"
        Title="Update available"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None">

    <!-- Same custom chrome as AddDownloadDialog/MessageBoxWindow (see AddDownloadDialog.axaml's
         comment). DialogTitleBar's own title replaces what used to be a duplicate
         TextBlock.SectionTitle line inside the body repeating the window Title. -->
    <Panel>
        <Border Margin="4" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" IsHitTestVisible="False" />

        <Grid Margin="4" RowDefinitions="Auto,*">
            <views:DialogTitleBar Grid.Row="0" Title="Update available" />

            <StackPanel Grid.Row="1" Margin="20,0,20,20" Spacing="14">
                <TextBlock Name="TxtVersion" TextWrapping="Wrap" />

                <ScrollViewer MaxHeight="220">
                    <TextBlock Name="TxtNotes" Classes="Caption" TextWrapping="Wrap" />
                </ScrollViewer>

                <ProgressBar Name="ProgressBar" Minimum="0" Maximum="100" IsVisible="False" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Name="BtnLater" Content="Later" Click="BtnLater_Click" />
                    <Button Name="BtnInstall" Content="Install Update" Classes="Primary" Click="BtnInstall_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Panel>

</Window>
