<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Yoink.Views"
        x:Class="Yoink.Views.LinuxUpdatePromptDialog"
        Title="Update available"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None">

    <!-- Same custom chrome as UpdatePromptDialog/AddDownloadDialog/MessageBoxWindow. A focused
         sibling of UpdatePromptDialog rather than a branch inside it — see this class's own doc
         comment for why: there's no download/progress step here at all, just a link out, since
         installing a .deb needs root and isn't something this app can do for you. -->
    <Panel>
        <Border Margin="4" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" IsHitTestVisible="False" />

        <Grid Margin="4" RowDefinitions="Auto,*">
            <views:DialogTitleBar Grid.Row="0" Title="Update available" />

            <StackPanel Grid.Row="1" Margin="20,0,20,20" Spacing="14">
                <TextBlock Name="TxtVersion" TextWrapping="Wrap" />

                <TextBlock Classes="Caption" TextWrapping="Wrap"
                           Text="Yoink doesn't install .deb updates itself — installing one needs root. Opening the release page lets you download and install the new version yourself." />

                <ScrollViewer MaxHeight="220">
                    <TextBlock Name="TxtNotes" Classes="Caption" TextWrapping="Wrap" />
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Name="BtnLater" Content="Later" Click="BtnLater_Click" />
                    <Button Name="BtnOpenReleasePage" Content="Open Release Page" Classes="Primary" Click="BtnOpenReleasePage_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Panel>

</Window>
