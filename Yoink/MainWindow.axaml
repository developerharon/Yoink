<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Yoink"
        x:Class="Yoink.MainWindow"
        Title="Yoink"
        Width="720" Height="640"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Yoink" Classes="AppTitle" />
                <TextBlock Text="Grab a video, keep watching." Classes="Subtitle" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Theme" Classes="Caption" VerticalAlignment="Center" />
                <ComboBox Name="CboTheme" Width="100" SelectionChanged="CboTheme_SelectionChanged">
                    <ComboBoxItem>System</ComboBoxItem>
                    <ComboBoxItem>Light</ComboBoxItem>
                    <ComboBoxItem>Dark</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Download card -->
        <Border Grid.Row="1" Classes="Card" Margin="0,0,0,20">
            <StackPanel Spacing="14">
                <TextBlock Text="Download a video" Classes="SectionTitle" />

                <StackPanel Spacing="4">
                    <TextBlock Text="YouTube URL" Classes="Caption" />
                    <TextBox Name="TxtUrl" PlaceholderText="https://www.youtube.com/watch?v=..." />
                </StackPanel>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Spacing="4">
                        <TextBlock Text="Resolution" Classes="Caption" />
                        <ComboBox Name="CboResolution" Width="110" SelectedIndex="0">
                            <ComboBoxItem>360</ComboBoxItem>
                            <ComboBoxItem>480</ComboBoxItem>
                            <ComboBoxItem>720</ComboBoxItem>
                            <ComboBoxItem>1080</ComboBoxItem>
                            <ComboBoxItem>1440</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <Button Name="BtnDownload" Content="Download" Classes="Primary"
                            DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Click="BtnDownload_Click" />
                </DockPanel>

                <Grid ColumnDefinitions="*,Auto">
                    <ProgressBar Name="ProgressBar" Grid.Column="0" Minimum="0" Maximum="100"
                                 VerticalAlignment="Center" />
                    <TextBlock Name="LblPercentage" Grid.Column="1" Text="0%" Classes="Caption"
                               MinWidth="42" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Recent downloads -->
        <Border Grid.Row="2" Classes="Card">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Recent downloads" Classes="SectionTitle" />
                <TextBlock Name="TxtEmptyHistory" DockPanel.Dock="Top" Classes="Caption" TextWrapping="Wrap"
                           Text="Nothing downloaded yet — finished downloads will show up here."
                           Margin="0,4,0,0" IsVisible="False" />

                <ListBox Name="LstHistory" Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:DownloadHistoryEntry">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Classes="Caption" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Status, Converter={x:Static local:DownloadStatusToBrushConverter.Instance}}" />
                                    <Button Content="Show in folder" FontSize="12" Tag="{Binding FilePath}"
                                            IsVisible="{Binding CanShowInFolder}" Click="ShowInFolder_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

    </Grid>

</Window>
