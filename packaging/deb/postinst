#!/bin/sh
# Best-effort desktop/icon cache refresh — `|| true` throughout so a minimal chroot/container
# install missing either tool never fails the package install itself.
set -e

gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
update-desktop-database /usr/share/applications >/dev/null 2>&1 || true

exit 0
